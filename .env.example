# Supabase: Project Settings > Database > Connection string (URI) — reemplazá [YOUR-PASSWORD]
DATABASE_URL=postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres
JWT_SECRET=CHANGE_ME_use_a_long_random_string

# Opcional: credenciales del admin creado por scripts/seed.mjs
SEED_ADMIN_EMAIL=admin@duo1913.com
SEED_ADMIN_PASSWORD=admin123

# Envío de mails (recuperación de contraseña) — Gmail con contraseña de aplicación:
# https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos)
SMTP_USER=tucuenta@gmail.com
SMTP_PASSWORD=la-app-password-de-16-letras

# URL pública del sitio, para armar el link del mail.
# Si no se define, se deduce del request.
NEXT_PUBLIC_SITE_URL=https://duo19-13.vercel.app
